# Generate unique secrets before first startup. Use URL-safe letters/digits for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=chattp-storage
MINIO_SECRET_KEY=

CHAT_HOST=chat.localhost
ADMIN_HOST=admin.localhost
HTTPS_PORT=8443
BIND_IP=127.0.0.1

LOCAL_ADMIN_USER=local-admin
LOCAL_ADMIN_PASSWORD=
# Optional, loopback-only demo logins without AD.
DEMO_USER_1_PASSWORD=
DEMO_USER_2_PASSWORD=

AD_URLS=
AD_BASE_DN=
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_CA_PEM_BASE64=
AD_TEACHER_GROUP_DN=
AD_STAFF_GROUP_DN=
AD_ADMIN_GROUP_DN=

# Optional. Enable Compose profile search and set OPENSEARCH_URL=http://opensearch:9200.
OPENSEARCH_URL=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
